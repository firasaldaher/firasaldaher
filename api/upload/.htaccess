# ============================================================
#  Caraway Upload API — Apache Security Config
# ============================================================

# Only allow PHP execution in this folder
Options -Indexes
Options -ExecCGI

# Block direct access to non-PHP files
<FilesMatch "^(?!index\.php$)">
    Require all denied
</FilesMatch>

# PHP upload limits (override server defaults)
php_value upload_max_filesize 210M
php_value post_max_size 215M
php_value max_execution_time 300
php_value memory_limit 256M
php_value max_input_time 300
